+++ b/wearable/data/map.html
@@ -0,0 +1,159 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>RAMS — Offline Map</title>
+  <link rel="stylesheet" href="/style.css">
+  <style>
+    body {
+      justify-content: flex-start;
+      padding: 16px;
+    }
+    .card {
+      max-width: 600px;
+      padding: 20px;
+    }
+    .map-container {
+      position: relative;
+      width: 100%;
+      height: 320px;
+      background: #090d1a;
+      border: 1px solid #27272a;
+      border-radius: 12px;
+      overflow: hidden;
+      margin: 14px 0;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+    }
+    .map-grid {
+      position: absolute;
+      inset: 0;
+      background-image: 
+        linear-gradient(to right, rgba(255,255,255,0.05) 1px, transparent 1px),
+        linear-gradient(to bottom, rgba(255,255,255,0.05) 1px, transparent 1px);
+      background-size: 32px 32px;
+    }
+    .gps-pin {
+      position: absolute;
+      width: 14px;
+      height: 14px;
+      border-radius: 50%;
+      background: #ef4444;
+      border: 2px solid #ffffff;
+      box-shadow: 0 0 12px rgba(239, 68, 68, 0.8);
+      transform: translate(-50%, -50%);
+      transition: left 0.3s ease, top 0.3s ease;
+      display: none;
+    }
+    .gps-pin::after {
+      content: '';
+      position: absolute;
+      inset: -6px;
+      border-radius: 50%;
+      border: 1.5px solid rgba(239, 68, 68, 0.5);
+      animation: pulse 1.8s infinite;
+    }
+    @keyframes pulse {
+      0% { transform: scale(0.8); opacity: 1; }
+      100% { transform: scale(2.2); opacity: 0; }
+    }
+    .map-meta {
+      display: flex;
+      justify-content: space-between;
+      font-family: 'JetBrains Mono', monospace;
+      font-size: 11px;
+      color: #a1a1aa;
+      margin-top: 6px;
+    }
+  </style>
+</head>
+<body>
+  <div class="card">
+    <div class="brand-header">
+      <img src="/logo.jpg" class="brand-logo" alt="RAMS Logo">
+      <h1>Road Accident Monitoring</h1>
+    </div>
+    <p class="subtitle">Offline Map & Local Positioning</p>
+
+    <div style="text-align: center;">
+      <div class="connection-badge">
+        <span class="badge-dot connecting" id="wsDot"></span>
+        <span id="wsText">CONNECTING...</span>
+      </div>
+    </div>
+
+    <div class="map-container" id="mapContainer">
+      <div class="map-grid"></div>
+      <div id="gpsPin" class="gps-pin"></div>
+      <div id="noFixBanner" style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #a1a1aa; text-transform: uppercase;">
+        WAITING FOR GPS SATELLITE FIX...
+      </div>
+    </div>
+
+    <div class="map-meta">
+      <span id="coordDisplay">LAT: --.------  LON: --.------</span>
+      <span id="satDisplay">0 SATELLITES</span>
+    </div>
+
+    <div class="nav">
+      <a href="/">SETUP</a>
+      <a href="/telemetry">LIVE TELEMETRY</a>
+      <a href="/map" class="active">OFFLINE MAP</a>
+    </div>
+  </div>
+
+  <script src="/app.js"></script>
+  <script>
+    // Known map corner coordinates for Cagayan / Tuguegarao area (spec defaults)
+    var MAP_BOUNDS = {
+      topLat: 17.6500,
+      bottomLat: 17.5800,
+      leftLon: 121.6800,
+      rightLon: 121.7800
+    };
+
+    function updateMapPin(lat, lon, hasFix, sats) {
+      var pin = document.getElementById('gpsPin');
+      var banner = document.getElementById('noFixBanner');
+      var coords = document.getElementById('coordDisplay');
+      var satEl = document.getElementById('satDisplay');
+
+      satEl.textContent = (sats || 0) + ' SATELLITES' + (hasFix ? ' (FIX)' : ' (NO FIX)');
+
+      if (!hasFix) {
+        pin.style.display = 'none';
+        banner.style.display = 'block';
+        coords.textContent = 'LAT: --.------  LON: --.------';
+        return;
+      }
+
+      banner.style.display = 'none';
+      pin.style.display = 'block';
+      coords.textContent = 'LAT: ' + lat.toFixed(6) + '  LON: ' + lon.toFixed(6);
+
+      // Interpolate inside bounds (0 to 100%)
+      var xPct = (lon - MAP_BOUNDS.leftLon) / (MAP_BOUNDS.rightLon - MAP_BOUNDS.leftLon);
+      var yPct = (MAP_BOUNDS.topLat - lat) / (MAP_BOUNDS.topLat - MAP_BOUNDS.bottomLat);
+
+      // Clamp to visible viewport
+      if (xPct < 0.05) xPct = 0.05;
+      if (xPct > 0.95) xPct = 0.95;
+      if (yPct < 0.05) yPct = 0.05;
+      if (yPct > 0.95) yPct = 0.95;
+
+      pin.style.left = (xPct * 100) + '%';
+      pin.style.top = (yPct * 100) + '%';
+    }
+
+    function handleWsMap(data) {
+      if (data.type === 'gps') {
+        updateMapPin(data.lat, data.lon, data.fix, data.sats);
+      }
+    }
+
+    initWebSocket(handleWsMap);
+  </script>
+</body>
+</html>
