+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>RAMS — Live Telemetry</title>
+  <link rel="stylesheet" href="/style.css">
+  <style>
+    body {
+      justify-content: flex-start;
+      padding: 16px;
+    }
+    .card {
+      max-width: 600px;
+      padding: 20px;
+    }
+    .grid-2 {
+      display: grid;
+      grid-template-columns: 1fr 1fr;
+      gap: 10px;
+      margin: 12px 0;
+    }
+    .grid-3 {
+      display: grid;
+      grid-template-columns: 1fr 1fr 1fr;
+      gap: 8px;
+      margin: 10px 0;
+    }
+    .metric-card {
+      background: #18181b;
+      border: 1px solid #27272a;
+      border-radius: 10px;
+      padding: 10px 12px;
+      text-align: center;
+    }
+    .metric-title {
+      font-family: 'JetBrains Mono', monospace;
+      font-size: 9px;
+      font-weight: 700;
+      color: #a1a1aa;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+    }
+    .metric-val {
+      font-family: 'JetBrains Mono', monospace;
+      font-size: 16px;
+      font-weight: 800;
+      color: #ffffff;
+      margin-top: 4px;
+    }
+    .fsm-badge {
+      display: inline-block;
+      padding: 4px 10px;
+      border-radius: 6px;
+      font-family: 'JetBrains Mono', monospace;
+      font-size: 11px;
+      font-weight: 800;
+      text-transform: uppercase;
+      margin-top: 4px;
+      background: #27272a;
+      color: #a1a1aa;
+    }
+    .fsm-0 { background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); }
+    .fsm-1 { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245,158,11,0.3); }
+    .fsm-2 { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239,68,68,0.4); }
+    .fsm-3 { background: rgba(168, 85, 247, 0.2); color: #c084fc; border: 1px solid rgba(168,85,247,0.4); }
+    .fsm-4 { background: rgba(239, 68, 68, 0.4); color: #ffffff; border: 1px solid #ef4444; }
+    canvas {
+      width: 100%;
+      height: 110px;
+      background: #111422;
+      border: 1px solid #27272a;
+      border-radius: 8px;
+      margin-top: 6px;
+      display: block;
+    }
+    .chart-label {
+      font-family: 'JetBrains Mono', monospace;
+      font-size: 10px;
+      color: #a1a1aa;
+      text-transform: uppercase;
+      margin-top: 10px;
+      display: flex;
+      justify-content: space-between;
+    }
+  </style>
+</head>
+<body>
+  <div class="card">
+    <div class="brand-header">
+      <img src="/logo.jpg" class="brand-logo" alt="RAMS Logo">
+      <h1>Road Accident Monitoring</h1>
+    </div>
+    <p class="subtitle">Live Diagnostics & Sensor Stream</p>
+
+    <div style="text-align: center; margin-bottom: 12px;">
+      <div class="connection-badge">
+        <span class="badge-dot connecting" id="wsDot"></span>
+        <span id="wsText">CONNECTING...</span>
+      </div>
+    </div>
+
+    <!-- FSM State & Peak Magnitude -->
+    <div class="grid-2">
+      <div class="metric-card">
+        <div class="metric-title">FSM State</div>
+        <div id="fsmBadge" class="fsm-badge fsm-0">0: IDLE (ARMED)</div>
+      </div>
+      <div class="metric-card">
+        <div class="metric-title">Accel Magnitude (|A|)</div>
+        <div class="metric-val" id="valAm">1.000 g</div>
+      </div>
+    </div>
+
+    <!-- Live Accelerometer Readings -->
+    <div class="grid-3">
+      <div class="metric-card">
+        <div class="metric-title">Accel X</div>
+        <div class="metric-val" id="valAx">0.00 g</div>
+      </div>
+      <div class="metric-card">
+        <div class="metric-title">Accel Y</div>
+        <div class="metric-val" id="valAy">0.00 g</div>
+      </div>
+      <div class="metric-card">
+        <div class="metric-title">Accel Z</div>
+        <div class="metric-val" id="valAz">1.00 g</div>
+      </div>
+    </div>
+
+    <div class="chart-label">
+      <span>Accel Waveform (X=Red, Y=Green, Z=Blue)</span>
+      <span id="rateLabel">100Hz IMU</span>
+    </div>
+    <canvas id="chartA" width="560" height="110"></canvas>
+
+    <!-- Gyroscope Readings -->
+    <div class="grid-3" style="margin-top: 14px;">
+      <div class="metric-card">
+        <div class="metric-title">Gyro X</div>
+        <div class="metric-val" id="valGx">0.0 °/s</div>
+      </div>
+      <div class="metric-card">
+        <div class="metric-title">Gyro Y</div>
+        <div class="metric-val" id="valGy">0.0 °/s</div>
+      </div>
+      <div class="metric-card">
+        <div class="metric-title">Gyro Z</div>
+        <div class="metric-val" id="valGz">0.0 °/s</div>
+      </div>
+    </div>
+
+    <!-- GPS Data -->
+    <div class="grid-3" style="margin-top: 14px;">
+      <div class="metric-card">
+        <div class="metric-title">Latitude</div>
+        <div class="metric-val" id="valLat">--.------</div>
+      </div>
+      <div class="metric-card">
+        <div class="metric-title">Longitude</div>
+        <div class="metric-val" id="valLon">--.------</div>
+      </div>
+      <div class="metric-card">
+        <div class="metric-title">Sats / Fix</div>
+        <div class="metric-val" id="valSats">0 / NO</div>
+      </div>
+    </div>
+
+    <div class="nav">
+      <a href="/">SETUP</a>
+      <a href="/telemetry" class="active">LIVE TELEMETRY</a>
+      <a href="/map">OFFLINE MAP</a>
+    </div>
+  </div>
+
+  <script src="/app.js"></script>
+  <script>
+    var FSM_NAMES = ['0: IDLE', '1: FREEFALL', '2: WAIT IMPACT', '3: STILLNESS', '4: CONFIRMED'];
+    var aHistory = [];
+    var maxPoints = 120;
+    var canvasA = document.getElementById('chartA');
+    var ctxA = canvasA.getContext('2d');
+
+    function drawChart() {
+      var w = canvasA.width;
+      var h = canvasA.height;
+      ctxA.clearRect(0, 0, w, h);
+
+      // Grid lines
+      ctxA.strokeStyle = '#1e243b';
+      ctxA.lineWidth = 1;
+      ctxA.beginPath();
+      ctxA.moveTo(0, h/2);
+      ctxA.lineTo(w, h/2);
+      ctxA.stroke();
+
+      if (aHistory.length < 2) return;
+
+      var step = w / (maxPoints - 1);
+      var colors = ['#f87171', '#34d399', '#60a5fa'];
+
+      for (var axis = 0; axis < 3; axis++) {
+        ctxA.strokeStyle = colors[axis];
+        ctxA.lineWidth = 1.5;
+        ctxA.beginPath();
+        for (var i = 0; i < aHistory.length; i++) {
+          var x = i * step;
+          // Scale -4g to +4g into canvas height
+          var val = aHistory[i][axis];
+          var y = (h / 2) - (val * (h / 8));
+          if (y < 2) y = 2;
+          if (y > h - 2) y = h - 2;
+          if (i === 0) ctxA.moveTo(x, y);
+          else ctxA.lineTo(x, y);
+        }
+        ctxA.stroke();
+      }
+    }
+
+    function handleWsTelemetry(data) {
+      if (data.type === 'tel') {
+        document.getElementById('valAx').textContent = data.ax.toFixed(2) + ' g';
+        document.getElementById('valAy').textContent = data.ay.toFixed(2) + ' g';
+        document.getElementById('valAz').textContent = data.az.toFixed(2) + ' g';
+        document.getElementById('valAm').textContent = data.am.toFixed(3) + ' g';
+
+        document.getElementById('valGx').textContent = data.gx.toFixed(1) + ' °/s';
+        document.getElementById('valGy').textContent = data.gy.toFixed(1) + ' °/s';
+        document.getElementById('valGz').textContent = data.gz.toFixed(1) + ' °/s';
+
+        var fsmBadge = document.getElementById('fsmBadge');
+        var fsm = data.fsm || 0;
+        fsmBadge.className = 'fsm-badge fsm-' + fsm;
+        fsmBadge.textContent = FSM_NAMES[fsm] || ('STATE ' + fsm);
+
+        aHistory.push([data.ax, data.ay, data.az]);
+        if (aHistory.length > maxPoints) aHistory.shift();
+        drawChart();
+      } else if (data.type === 'gps') {
+        document.getElementById('valLat').textContent = data.fix ? data.lat.toFixed(6) : 'NO FIX';
+        document.getElementById('valLon').textContent = data.fix ? data.lon.toFixed(6) : 'NO FIX';
+        document.getElementById('valSats').textContent = (data.sats || 0) + (data.fix ? ' / FIX' : ' / NO');
+      }
+    }
+
+    initWebSocket(handleWsTelemetry);
+    drawChart();
+  </script>
+</body>
+</html>
