(global_label "GND" (shape bidirectional) (at 215.9 144.78 270) (effects (font (size 1.0 1.0)) (justify right)) (uuid "0f0d4378-f5f2-5871-96d7-3307b1f42339"))
(rectangle (start 12 18) (end 147 221) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "214b0ac6-956c-54a7-85ff-46e0b2d0b89d"))
(text "07  ESP32-S3FH4R2 / PIN CONTRACT" (at 14.5 20.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "a1a882d4-215a-5afa-8d3b-2b49560e86b4"))
(text "4 MB embedded flash + 2 MB quad PSRAM; initial build leaves PSRAM disabled." (at 14.5 199.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "b8ea2ff3-f2ae-54cb-b67d-f03841e90c90"))
(text "Phone GPS/IMU -> BLE -> U1 -> LoRa. No separate GPS/IMU hardware added." (at 14.5 201.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "3a4ff737-4389-584f-96e1-4630a18d1edf"))
(text "GPIO0 BOOT/cancel; 1 buzzer; 2 ADC; 8/9 LoRa interrupt/reset." (at 14.5 204.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "966d1381-0d00-54b6-aaf8-c20ee6fca6c1"))
(text "GPIO10/11/12/13 NSS/MOSI/SCK/MISO; 19/20 USB D-/D+; 48 RGB." (at 14.5 207.4 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "1d8c015e-9570-5685-a977-945ca5a60cb2"))
(text "Exposed pad 57 is GND and a thermal path; inspect the hidden solder joint." (at 14.5 210.2 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "b614f339-5c26-5f9e-9cda-b1347ef22430"))
(rectangle (start 153 18) (end 408 101) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "9056cbb5-6c96-50a8-b37b-35f08f95b0db"))
(text "08  LOCAL BYPASS / RF SUPPLY FEED" (at 155.5 20.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "2ed9b7f5-6811-5095-bd16-0f9b42afe4de"))
(text "L1 + C11/C12/C13 feed/bypass VDD_RF; C14 supports main rail; C15/C16 serve CPU/RTC; C21/C22 analog supply." (at 155.5 92.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "23ad35ee-e2e5-5a5c-849b-7c7f48cd66d1"))
(text "C17/C20 bypass internally supplied VDD_SPI: do not tie it to +3V3. Ideal |XC|=1/(2*pi*f*C); real ESR/ESL and placement matter." (at 155.5 94.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "0ccd2a76-4f0e-5d02-a57c-30d780ba31cb"))
(rectangle (start 153 107) (end 281 212) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "3d30aa33-30a7-5e1a-9204-241271d5db52"))
(text "09  RESET / BOOT / STRAPS" (at 155.5 109.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "c161ebda-9a18-5a41-8f6f-ba961fc8d07c"))
(text "R8*C33 = 10k*1uF = 10 ms. EN(t)=VDD*(1-exp(-t/tau)); 63% at tau." (at 155.5 195.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "e51e9167-aa20-56c5-9d2d-7586d1dae3f3"))
(text "Reset release depends on the input threshold and supply ramp, not exactly 10 ms." (at 155.5 197.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "e50f56e2-7c87-5131-b5f2-8e3334a3a932"))
(text "R34 holds GPIO0 high; R35/R36 hold GPIO45/46 low while straps are sampled." (at 155.5 200.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "480cb027-687b-586d-9d46-b09172799cc4"))
(text "Buttons on sheet 4: hold BOOT, tap RESET, release BOOT to enter download." (at 155.5 203.4 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "d03e38c7-7c84-53d2-98c7-6a7158252d9b"))
(rectangle (start 287 107) (end 408 212) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "1a603b34-e0d2-57ae-985e-afe00884f045"))
(text "10  40 MHz CLOCK / INITIAL LOADS" (at 289.5 109.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "57e00ce3-6c70-5f16-9e81-23fe3807837a"))
(text "CL ~= C24*C25/(C24+C25)+Cstray = 6pF + assumed 4pF = 10pF." (at 289.5 195.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "830da747-c936-5051-b04d-9844d54e626b"))
(text "12pF is an available starting pair; actual stray capacitance is unmeasured." (at 289.5 197.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "c42b4da3-d5c2-5624-aee0-b9781584ca49"))
(text "R9 22R damps/limits drive. It differs from Espressif's 24nH starting guidance." (at 289.5 200.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "3dde6a0c-b011-5580-bb81-f72ad49247cd"))
(text "Measure startup, frequency and drive/harmonics; these parts are not tuned yet." (at 289.5 203.4 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "942074f4-3900-5709-b68a-881534030b2e"))
(rectangle (start 12 225) (end 298 282) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "a58158ef-a8d4-525b-88b7-3172041dec91"))
(text "11  2.4 GHz MATCHING / ANTENNA — STARTING VALUES" (at 14.5 227.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "d5b2ea16-a853-5da5-8adf-9e56114cc8e0"))
(text "CLC: 1.5pF / 2.4nH / 1.5pF. Antenna network: 1.2pF series / 2.7nH shunt / 3.3nH series. ANT1 pin2 is intentionally NC." (at 14.5 268.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "0c479c9b-a6fe-5f17-9f83-73d698357603"))
(text "At 2.4GHz: XL(2.4nH)=36.2R; |XC|(1.5pF)=44.2R (ideal examples, not proof of a 50R match)." (at 14.5 270.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "6036ab43-6522-53dd-830a-f88b53a958ed"))
(text "Tune with actual board/enclosure/body loading. Keep antenna no-metal area clear; LoRa uses a separate 433MHz antenna." (at 14.5 273.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "93e2c2e2-9cfa-5d3d-bc5c-072628762dd1")))
