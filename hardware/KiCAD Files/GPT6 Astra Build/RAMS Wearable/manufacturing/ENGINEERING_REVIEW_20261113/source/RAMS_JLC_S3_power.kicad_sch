(global_label "GND" (shape bidirectional) (at 381.0 217.17 270) (effects (font (size 1.0 1.0)) (justify right)) (uuid "e64fda99-baa8-5978-9ce7-fea4c59a81a0"))
(rectangle (start 12 18) (end 138 143) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "dbebdb33-51e5-5e09-b494-e3f5a9ddc661"))
(text "01  USB-C INPUT / ESD" (at 14.5 20.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "d7123415-d701-5211-a84b-9419291984b6"))
(text "R1/R2 5.1k: USB-C sink detection in either orientation; no USB-PD negotiation." (at 14.5 128.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "f62d294b-2c0c-56f6-afe1-0f46c7333942"))
(text "D1 clamps fast ESD; C1/C2 locally bypass VBUS. Keep the ESD return short." (at 14.5 130.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "5b2bc120-31da-54a7-8bdd-7d62c6b2d59c"))
(text "Power: VBUS -> D2 -> SYS_IN. Data: D1 -> R38/R39 -> GPIO19/20 (sheet 4)." (at 14.5 133.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "c327a86a-87b0-5294-8a10-620c7de2e1c5"))
(rectangle (start 144 18) (end 270 143) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "b99e8645-d1b9-54f4-8113-f9c0292ebe08"))
(text "02  SINGLE-CELL 4.2 V CHARGER" (at 146.5 20.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "e41201ac-2d72-5087-a440-eee6ca03bd4a"))
(text "U3: constant-current then constant-voltage charge. C3 input / C4 battery bypass." (at 146.5 128.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "72e5529e-d655-52b7-aac7-2d0ef76c9d1b"))
(text "I_CHG ~= 1000 x 1 V / 10k = 100 mA (0.2C at 500 mAh; 0.1C at 1000 mAh)." (at 146.5 130.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "beded106-5d99-5eef-9dad-0d70e97c8b1c"))
(text "R30 initially DNP. Fit after cell/polarity/rating checks; verify charge and heat." (at 146.5 133.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "9287a58d-d3ca-53c2-bfce-b101417074b8"))
(rectangle (start 276 18) (end 408 143) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "99f82d16-8ac2-5116-a5c9-3b288ee129be"))
(text "03  CELL CONNECTOR / PROTECTION" (at 278.5 20.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "389e7a9c-449e-570b-80fc-937ef9200536"))
(text "U4 monitors the cell; opposing Q3 MOSFETs interrupt its return during faults." (at 278.5 128.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "11c1d43d-ca2a-569b-a093-a64ff0cd39fb"))
(text "R4/C5: tau = 100R x 100nF = 10 us; ideal fc = 1/(2*pi*RC) = 15.9 kHz." (at 278.5 130.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "9e10cc63-cdbb-5041-a377-414e8c90658f"))
(text "R5 is the sense-input resistor. B_MINUS != GND: do not bypass Q3." (at 278.5 133.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "99196565-198b-5b63-ba80-6a1a084a36f2"))
(rectangle (start 12 148) (end 138 271) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "7cbeb284-512b-52e4-9d6e-ffbb158cc106"))
(text "04  SOURCE SHARING / CONTROL-ONLY SWITCH" (at 14.5 150.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "5fc81d60-5659-539d-9fbb-54b51c35cd88"))
(text "USB: VBUS -> D2 -> SYS_IN. Battery: B_PLUS -> Q1 -> SYS_IN." (at 14.5 241.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "a2cfecb5-25dd-5f22-8c57-b54a26da141c"))
(text "R6 pulls Q1 gate low without USB; USB raises its gate to isolate the cell path." (at 14.5 243.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "8ba363d6-2f4b-5c65-98c5-90ae68b872bb"))
(text "SW1 ON grounds LED_GATE; OFF grounds SYS_EN. R7/R41 are pull-ups." (at 14.5 246.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "51454aeb-bdef-5a37-9b00-aebd1b872230"))
(text "Contacts carry control current only: 4.2 V / 100k = 42 uA per grounded pull-up." (at 14.5 249.4 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "bc498b9d-c057-5d6d-af62-d238abd3cc42"))
(text "OFF disables loads; charging/protection are still connected. Q5/R41: sheet 4." (at 14.5 252.2 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "e32f16f7-fc41-5c3e-b6c6-92ca30485d06"))
(rectangle (start 144 148) (end 270 271) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "2fffffb9-ceb7-5952-b08c-75703a35672a"))
(text "05  3.3 V LDO / LOCAL BULK CAPACITANCE" (at 146.5 150.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "ad51798f-3eb6-57ba-8b64-368606c4f108"))
(text "U5 reuses the owned linear regulator; C7/C10 support input/output transients." (at 146.5 241.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "fa9d1814-ecf8-5d7d-bacb-0bb645a6f293"))
(text "Heat ~= (VSYS - 3.3 V)*Iavg; example (4.7 - 3.3)*0.25 A = 0.35 W." (at 146.5 243.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "36b59115-64d9-5ce2-b9dd-d52ba8f18e31"))
(text "Droop ~= deltaI*deltat/Ceff + ESR step; 100mA*10us/10uF = 0.10 V." (at 146.5 246.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "81d07c7c-2745-5d5c-b0fe-090b3866c7d3"))
(text "This is brief charge support, not guaranteed brownout prevention; DC bias lowers C." (at 146.5 249.4 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "b72a3656-a412-53c4-a11e-9abe2b86f9ed"))
(text "Verify rail sag + temperature. A 600 mA rating is not an enclosed thermal guarantee." (at 146.5 252.2 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "259bc435-a2a8-594e-ac67-9364374048f6"))
(rectangle (start 276 148) (end 408 253) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "da0b72b0-598d-575e-8a3f-24f8e7b6cca9"))
(text "06  BATTERY ADC / OFF-STATE ISOLATION" (at 278.5 150.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "e573b427-af1a-5aca-94cc-6b5e6e4ad397"))
(text "VADC = VBAT*10/(30+10) = VBAT/4; 4.2 V -> 1.05 V; divider current 105 uA." (at 278.5 232.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "7e413138-501e-5c24-aa80-9bd471f978fe"))
(text "Q4 blocks cell-to-ADC drive when +3V3 is off. R16 discharges the node." (at 278.5 234.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "120d4c96-7838-5b4b-81a4-bc4a809e22fd"))
(text "ON: Rth ~= 30k||10k = 7.5k; 1nF gives tau 7.5us, fc 21.2kHz (ideal)." (at 278.5 237.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "b3c714a0-e0e9-5c7e-b446-af6777505cc1"))
(text "OFF: R16*C29 = 10us. Small C prioritizes safe discharge, not 5s report filtering." (at 278.5 240.4 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "3e53ce8d-2b0c-5c90-acd4-167be8beb72b"))
(text "J2 firmware uses calibrated mV x4 + averaging/EMA. Verify actual rail transitions." (at 278.5 243.2 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "827e5693-d503-53d8-ba93-12b85dd0e257")))
