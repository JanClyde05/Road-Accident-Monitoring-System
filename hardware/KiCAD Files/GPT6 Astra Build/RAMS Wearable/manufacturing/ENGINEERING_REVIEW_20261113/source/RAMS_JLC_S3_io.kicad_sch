(global_label "LED_PWR" (shape bidirectional) (at 269.24 269.24 270) (effects (font (size 1.0 1.0)) (justify right)) (uuid "542a212f-db51-5d8c-b8ba-ffd1d5e93408"))
(rectangle (start 12 18) (end 138 161) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "b88dbee4-69cc-50da-8a89-92e0e8d727c2"))
(text "12  Ra-02 / FILTERED SUPPLY / SPI" (at 14.5 20.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "c0b04864-9251-5b59-8154-89d6acf7a419"))
(text "FB1 + C26/C27 isolate/bypass radio supply; ferrite Z depends on frequency." (at 14.5 144.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "286a1c98-0fea-5aa9-8918-90f250e8d734"))
(text "R11 33R damps SCK; R37 10k keeps NSS high/unselected at startup." (at 14.5 146.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "86e692b5-ba1d-55bf-bf21-dcd51ff4eba1"))
(text "433MHz / SF9 / BW125kHz / CR4/5 / 17dBm / sync0x34." (at 14.5 149.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "3f38ec0e-b0af-50b9-adf3-6bfb9b304f66"))
(text "Fit 433MHz antenna before TX. Hand-solder bottom module after top reflow." (at 14.5 152.4 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "bbc474ef-db52-5ef1-87a1-385aff849066"))
(rectangle (start 144 18) (end 290 161) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "864494c0-672b-55f7-bbdc-08e7b55066d4"))
(text "13  RGB POWER / DATA LEVEL TRANSLATION" (at 146.5 20.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "3d6a88ba-e27e-5a7d-b68e-d845decb7354"))
(text "Q5 switches raw SYS_IN; R41 pulls gate off. U6 translates 3.3V GPIO48 to LED_PWR." (at 146.5 144.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "f41f121c-0bd3-54f7-9598-77e9bd069e6d"))
(text "C34/C35 bypass both U6 rails; C28 bypasses LED. R13 damps; R42/R43 pull data low." (at 146.5 146.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "09fad3a5-4432-5fb5-8635-027adb5d1907"))
(text "0 bit H/L=300/1000ns; 1 bit=700/600ns; reset >=300us LOW (J2 RMT profile)." (at 146.5 149.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "15f7a021-0350-5556-9d7f-9379f46fe645"))
(text "LED1 initially DNP: qualify exact stock voltage/pinout/current. No LED power boost." (at 146.5 152.4 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "718d3574-9cca-5c0c-a5ad-00348da4749d"))
(rectangle (start 296 18) (end 408 161) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "bdbb2710-d56a-5e0e-a391-1d0ad9ba20b4"))
(text "14  ACTIVE BUZZER / NPN DRIVER" (at 298.5 20.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "e63a9ed3-336a-578c-af53-f4d9bf89f7c8"))
(text "Load current: +3V3 -> BZ1 -> Q2 -> GND. GPIO1 supplies base drive." (at 298.5 144.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "81eee9df-9efd-5e46-8542-18b824a2b061"))
(text "IB ~= (3.3-0.8)/330 = 7.58mA (assumed VBE). Conservative example:" (at 298.5 146.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "34fd0281-9ce1-52c2-9de3-ef944fafa80b"))
(text "(2.4-1.2)/330=3.64mA; forced gain10 suggests ~36mA load." (at 298.5 149.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "75e867e8-be57-5558-8d16-56ddb8b0ab9e"))
(text "R14 holds OFF; D3 handles inductive transients. Verify actual buzzer current." (at 298.5 152.4 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "53ec2f4d-f98a-59dd-b352-b015ec853c22"))
(rectangle (start 12 167) (end 138 248) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "6eb40c8b-a8fe-5530-840e-a25aa1170ed4"))
(text "CONTROLS / USB SERIES DAMPING" (at 14.5 169.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "5c6d07f0-a5b6-5856-9da6-48a66f05e021"))
(text "SW2 grounds MCU_EN; SW3 grounds GPIO0 for boot/cancel." (at 14.5 235.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "aaa8451c-11d7-54b0-83e0-61f3177f7163"))
(text "R38/R39 22R reduce USB edge ringing near the MCU; not a voltage divider." (at 14.5 237.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "ca232fb8-f1e7-52b6-97b9-24125f240591"))
(text "PCB differential geometry and stackup still need impedance confirmation." (at 14.5 240.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "9e79b565-d9f2-5a38-8468-d4d53d06b172"))
(rectangle (start 144 167) (end 290 248) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "0aad536c-cb9e-56af-84b2-b818722ff674"))
(text "15  TEST ACCESS / PROTECTED GROUND" (at 146.5 169.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "a176bb74-7a7c-5656-9e90-07cc1b3d30ac"))
(text "Use TP1/GND as system reference; do not short B_MINUS to GND via instruments." (at 146.5 243.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "dfec1772-1b2f-5c07-8395-e06a614de9c9"))
(rectangle (start 12 254) (end 290 282) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "7b2ea2a6-e270-50f0-b6b4-a128582d3379"))
(text "ERC SOURCE DECLARATIONS — SOFTWARE ONLY, NO PARTS TO BUY" (at 14.5 256.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "51d53a05-19d2-5171-b423-f912b31f2b5e"))
(rectangle (start 296 167) (end 408 252) (stroke (width 0.25) (type default)) (fill (type none)) (uuid "81ce5a89-e874-5059-a0c2-173de58facc8"))
(text "HOW TO READ / COST AND QUALITY" (at 298.5 169.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "c157a5cf-353e-5a26-85a5-8c60c6bc3d3c"))
(text "Same global net name = same electrical connection, across all sheets." (at 298.5 183.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "019b54cb-64bd-5d7a-afb3-2c6c29dd01fb"))
(text "Cross on a pin = deliberate no-connect. DNP = staged omission." (at 298.5 185.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "34048f3f-c2f0-537e-88e4-0aa61044238d"))
(text "Text/boxes/arrows explain the circuit; they are not electrical wires." (at 298.5 188.6 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "3ebb6b81-baf9-5621-9c81-71f4071f474d"))
(text "Equations use nominal values and stated assumptions; measure real behavior." (at 298.5 191.4 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "1859fc59-1ff4-510f-96f1-f7ee1d03a016"))
(text "Reuse suitable stock. Every added part should earn its cost and board space." (at 298.5 194.2 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "f967a53e-69f3-584b-9574-829dbf5816b7"))
(text "No new electrical components were added for this learning layout." (at 298.5 197.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "a54731b3-ba73-5767-a689-2602fed9b84c"))
(text "Full explanations, sources and lessons: docs/SCHEMATIC_LEARNING_NOTES.md." (at 298.5 199.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "e5c9dff7-4d13-53f4-a81a-40795b5550b9")))
